APP_NAME=Mukando API

# development | test | production
ENVIRONMENT=development

# LOCAL DATABASE - used automatically in development/test
DATABASE_URL_LOCAL=postgresql+psycopg://postgres:postgres@localhost:5432/mukando

# PRODUCTION DATABASE - used automatically when ENVIRONMENT=production
DATABASE_URL_PRODUCTION=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Optional backwards-compatible production variable
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

FRONTEND_URL=http://localhost:3000
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nPASTE_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30
RATE_LIMIT=100/minute
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
